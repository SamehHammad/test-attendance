generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Device {
  id        String    @id @default(cuid())
  name      String
  ip        String
  port      Int       @default(4370)
  location  String?
  isActive  Boolean   @default(true)
  lastSync  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  employees  Employee[]
  attendance AttendanceRecord[]

  @@map("devices")
}

model Employee {
  id           String   @id @default(cuid())
  deviceUserId String
  name         String
  department   String?
  position     String?
  deviceId     String
  device       Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  attendance AttendanceRecord[]

  @@unique([deviceUserId, deviceId])
  @@map("employees")
}

model AttendanceRecord {
  id           String    @id @default(cuid())
  deviceUserId String
  recordTime   DateTime
  type         Int       @default(0)
  deviceId     String
  employeeId   String?
  device       Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee     Employee? @relation(fields: [employeeId], references: [id])
  createdAt    DateTime  @default(now())

  @@map("attendance_records")
}

model SystemSetting {
  id             String   @id @default("global")
  
  // connectionMode ("local", "port", "tunnel", "vpn", "adms")
  networkMode    String   @default("local")
  
  // Mode: port
  publicIp       String?
  publicPort     Int?

  // Mode: tunnel (e.g. ngrok)
  tunnelUrl      String?
  
  // Mode: vpn / ssh / proxy
  vpnIp          String?
  vpnPort        Int?
  vpnUsername    String?
  vpnPassword    String?

  // Connection status
  isConnected    Boolean  @default(false)
  connectionStatus String? @default("disconnected") // "connected", "disconnected", "connecting", "error"
  lastConnectionTime DateTime?
  connectionError String?

  updatedAt      DateTime @updatedAt
  
  @@map("system_settings")
}
