{
  "name": "zk-attendance",
  "version": "1.0.3",
  "private": true,
  "description": "Trivvo Hr Attendance Management",
  "author": "Hesabate",
  "repository": {
    "type": "git",
    "url": "https://github.com/SamehHammad/test-attendance.git"
  },
  "main": "main.js",
  "build": {
    "appId": "com.hesabate.attendance",
    "productName": "Trivvo Hr",
    "compression": "normal",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "build/icons/**/*",
      "public/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public",
        "to": "standalone/public",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/icons",
        "to": "build/icons",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icons/icon.icns"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "SamehHammad",
        "repo": "test-attendance",
        "releaseType": "release"
      }
    ]
  },
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "build": "next build --webpack",
    "start": "next start -p 3000",
    "lint": "eslint",
    "build:copy-assets": "node scripts/copy-assets.mjs",
    "electron:dev": "npm run build && npm run build:copy-assets && npx electron .",
    "electron:build": "npm run build && npm run build:copy-assets && npx electron-builder build --win",
    "electron:publish": "npm run build && npm run build:copy-assets && npx electron-builder build --win --publish always"
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.41",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axios": "^1.16.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "node-zklib": "^1.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.76.0",
    "react-hot-toast": "^2.6.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^7.2.0",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
