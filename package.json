{
  "name": "zk-attendance",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "build": {
    "appId": "com.hesabate.attendance",
    "productName": "Trivvo Hr",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "!node_modules"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public",
        "to": "standalone/public",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icons/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icons/icon.icns"
    }
  },
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "build": "next build --webpack",
    "start": "next start -p 3000",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "build:copy-assets": "node scripts/copy-assets.mjs",
    "electron:dev": "npm run build && npm run build:copy-assets && npx electron .",
    "electron:build": "npm run build && npm run build:copy-assets && npx electron-builder build --win"
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^5.22.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.41",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axios": "^1.16.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "node-zklib": "^1.3.0",
    "prisma": "^5.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.76.0",
    "react-hot-toast": "^2.6.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^7.2.0",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
