{
  "name": "zk-attendance",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "build": {
    "appId": "com.hesabate.attendance",
    "productName": "نظام الحضور والانصراف",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      ".env",
      ".next/standalone/**/*",
      "public/**/*",
      "!node_modules"
    ],
    "asarUnpack": [
      ".next/standalone/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "build": "next build --webpack",
    "build:copy-assets": "xcopy /E /I /Y .next\\static .next\\standalone\\.next\\static && xcopy /E /I /Y public .next\\standalone\\public && xcopy /E /I /Y node_modules\\.prisma .next\\standalone\\node_modules\\.prisma && xcopy /E /I /Y node_modules\\@prisma\\client .next\\standalone\\node_modules\\@prisma\\client && copy /Y .env .next\\standalone\\.env",
    "start": "next start -p 3000",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "tauri": "npx tauri",
    "tauri:dev": "npx tauri dev",
    "tauri:build": "npm run build && npm run build:copy-assets && npx tauri build",
    "electron:dev": "npm run build && npm run build:copy-assets && npx electron .",
    "electron:build": "npm run build && npm run build:copy-assets && npx electron-builder build --win"
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^5.22.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.41",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axios": "^1.16.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "node-zklib": "^1.3.0",
    "prisma": "^5.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.76.0",
    "react-hot-toast": "^2.6.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^7.2.0",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
