{
  "info": {
    "name": "ZK Attendance APIs - Pro",
    "description": "مجموعة واجهات برمجة التطبيقات الاحترافية لنظام الحضور والانصراف وأجهزة ZKTeco البيومترية مع دعم الفلاتر المتقدمة، التصفح (Pagination)، والتحسينات فائقة السرعة للأداء.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "deviceId",
      "value": "ENTER_DEVICE_ID_HERE",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. الأجهزة (Devices)",
      "item": [
        {
          "name": "1.1 Get All Devices (جلب جميع الأجهزة مع فلاتر وبحث)",
          "request": {
            "method": "GET",
            "header": [],
            "description": "جلب قائمة أجهزة البصمة مع دعم الفلترة حسب الاسم أو الآي بي (search)، وحالة التفعيل (isActive)، ودعم التصفح (page & limit) لتحقيق أقصى سرعة استجابة.",
            "url": {
              "raw": "{{baseUrl}}/api/devices?search=&isActive=&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "devices"],
              "query": [
                {
                  "key": "search",
                  "value": "",
                  "description": "بحث باسم الجهاز أو الآي بي أو الموقع (اختياري)"
                },
                {
                  "key": "isActive",
                  "value": "",
                  "description": "true أو false للفلترة حسب حالة التشغيل (اختياري)"
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "رقم الصفحة للتصفح السريع"
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "عدد الأجهزة في كل صفحة"
                }
              ]
            }
          }
        },
        {
          "name": "1.2 Add New Device (إضافة جهاز جديد)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Main Door Device\",\n  \"ip\": \"192.168.1.201\",\n  \"port\": 4370,\n  \"location\": \"Main Entrance\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/devices",
              "host": ["{{baseUrl}}"],
              "path": ["api", "devices"]
            }
          }
        },
        {
          "name": "1.3 Get Device Details (تفاصيل الجهاز)",
          "request": {
            "method": "GET",
            "header": [],
            "description": "عرض بيانات جهاز بصمة محدد مع إحصائيات عدد الموظفين وسجلات الحضور.",
            "url": {
              "raw": "{{baseUrl}}/api/devices/{{deviceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "devices", "{{deviceId}}"]
            }
          }
        },
        {
          "name": "1.4 Update Device (تحديث الجهاز)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Device Name\",\n  \"ip\": \"192.168.1.202\",\n  \"port\": 4370,\n  \"location\": \"Second Floor\",\n  \"isActive\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/devices/{{deviceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "devices", "{{deviceId}}"]
            }
          }
        },
        {
          "name": "1.5 Delete Device (حذف الجهاز)",
          "request": {
            "method": "DELETE",
            "header": [],
            "description": "حذف الجهاز وكافة ارتباطاته من قاعدة البيانات.",
            "url": {
              "raw": "{{baseUrl}}/api/devices/{{deviceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "devices", "{{deviceId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "2. المزامنة والربط المباشر (Sync & Device Operations)",
      "item": [
        {
          "name": "2.1 Test Connection (اختبار الاتصال بالجهاز)",
          "request": {
            "method": "POST",
            "header": [],
            "description": "فحص اتصال TCP/UDP بجهاز البصمة والتأكد من استجابته وحالته.",
            "url": {
              "raw": "{{baseUrl}}/api/devices/{{deviceId}}/test-connection",
              "host": ["{{baseUrl}}"],
              "path": ["api", "devices", "{{deviceId}}", "test-connection"]
            }
          }
        },
        {
          "name": "2.2 Sync Data - Optimized (مزامنة ذكية فائقة السرعة مع فلاتر)",
          "request": {
            "method": "POST",
            "header": [],
            "description": "مزامنة بصمات الحضور من الجهاز إلى قاعدة البيانات بكفاءة عالية. تدعم فلاتر التاريخ، موظف محدد، وتحديد حد أقصى (limit). القيمة الافتراضية لـ includeData هي false لتجنب الحجم الهائل للبيانات في الـ Network، ويمكن تفعيلها إلى true عند الحاجة لعرض البيانات الخام.",
            "url": {
              "raw": "{{baseUrl}}/api/devices/{{deviceId}}/sync?startDate=&endDate=&deviceUserId=&limit=&includeData=false&syncUsers=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "devices", "{{deviceId}}", "sync"],
              "query": [
                {
                  "key": "startDate",
                  "value": "",
                  "description": "فلترة السجلات من تاريخ محدد (YYYY-MM-DD)"
                },
                {
                  "key": "endDate",
                  "value": "",
                  "description": "فلترة السجلات حتى تاريخ محدد (YYYY-MM-DD)"
                },
                {
                  "key": "deviceUserId",
                  "value": "",
                  "description": "مزامنة سجلات موظف معين فقط برقم البصمة"
                },
                {
                  "key": "limit",
                  "value": "",
                  "description": "الحد الأقصى لعدد السجلات المراد معالجتها في هذه العملية"
                },
                {
                  "key": "includeData",
                  "value": "false",
                  "description": "false لتقليل استهلاك الباندويث وتسريع الرد إلى أجزاء من الثانية، أو true لإرجاع كامل مصفوفة السجلات"
                },
                {
                  "key": "syncUsers",
                  "value": "true",
                  "description": "true لمزامنة وتحديث أسماء المستخدمين مع السجلات"
                }
              ]
            }
          }
        },
        {
          "name": "2.3 Sync Users (سحب ومزامنة الموظفين من الجهاز)",
          "request": {
            "method": "POST",
            "header": [],
            "description": "سحب قائمة الموظفين وبصماتهم المسجلة في جهاز ZKTeco وتحديثها في قاعدة البيانات.",
            "url": {
              "raw": "{{baseUrl}}/api/devices/{{deviceId}}/sync-users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "devices", "{{deviceId}}", "sync-users"]
            }
          }
        },
        {
          "name": "2.4 Sync Time (مزامنة وضبط توقيت الجهاز)",
          "request": {
            "method": "POST",
            "header": [],
            "description": "مزامنة ساعة جهاز البصمة مع توقيت السيرفر لضمان دقة أوقات الحضور والانصراف.",
            "url": {
              "raw": "{{baseUrl}}/api/devices/{{deviceId}}/sync-time",
              "host": ["{{baseUrl}}"],
              "path": ["api", "devices", "{{deviceId}}", "sync-time"]
            }
          }
        },
        {
          "name": "2.5 Get Device State (حالة الجهاز وسعته التخزينية)",
          "request": {
            "method": "GET",
            "header": [],
            "description": "جلب إحصائيات الذاكرة وسعة السجلات والمستخدمين والبصمات المخزنة في جهاز ZKTeco.",
            "url": {
              "raw": "{{baseUrl}}/api/devices/{{deviceId}}/device-state",
              "host": ["{{baseUrl}}"],
              "path": ["api", "devices", "{{deviceId}}", "device-state"]
            }
          }
        },
        {
          "name": "2.6 Get Device Parameters (معلمات ومواصفات الجهاز الهاردوير)",
          "request": {
            "method": "GET",
            "header": [],
            "description": "جلب الرقم التسلسلي للسيريال نمبر وإصدار الفيرموير وإعدادات الجهاز الداخلية.",
            "url": {
              "raw": "{{baseUrl}}/api/devices/{{deviceId}}/parameters",
              "host": ["{{baseUrl}}"],
              "path": ["api", "devices", "{{deviceId}}", "parameters"]
            }
          }
        },
        {
          "name": "2.7 Unlock Door (فتح الباب بالتحكم عن بُعد)",
          "request": {
            "method": "POST",
            "header": [],
            "description": "إرسال إشارة للريلاي في الجهاز لفتح الباب إلكترونياً (Access Control).",
            "url": {
              "raw": "{{baseUrl}}/api/devices/{{deviceId}}/unlock-door",
              "host": ["{{baseUrl}}"],
              "path": ["api", "devices", "{{deviceId}}", "unlock-door"]
            }
          }
        },
        {
          "name": "2.8 Clear Logs (مسح سجلات الحضور من الجهاز)",
          "request": {
            "method": "POST",
            "header": [],
            "description": "مسح سجلات الحضور والانصراف المخزنة على هاردوير الجهاز بعد مزامنتها بنجاح لتفريغ ذاكرة الجهاز.",
            "url": {
              "raw": "{{baseUrl}}/api/devices/{{deviceId}}/clear-logs",
              "host": ["{{baseUrl}}"],
              "path": ["api", "devices", "{{deviceId}}", "clear-logs"]
            }
          }
        },
        {
          "name": "2.9 Reboot Device (إعادة تشغيل الجهاز)",
          "request": {
            "method": "POST",
            "header": [],
            "description": "إرسال أمر Restart لإعادة تشغيل جهاز البصمة.",
            "url": {
              "raw": "{{baseUrl}}/api/devices/{{deviceId}}/reboot",
              "host": ["{{baseUrl}}"],
              "path": ["api", "devices", "{{deviceId}}", "reboot"]
            }
          }
        },
        {
          "name": "2.10 Power Off Device (إغلاق الجهاز)",
          "request": {
            "method": "POST",
            "header": [],
            "description": "إيقاف تشغيل جهاز البصمة برمجياً.",
            "url": {
              "raw": "{{baseUrl}}/api/devices/{{deviceId}}/power-off",
              "host": ["{{baseUrl}}"],
              "path": ["api", "devices", "{{deviceId}}", "power-off"]
            }
          }
        },
        {
          "name": "2.11 Disable Device (تعطيل قفل الجهاز مؤقتاً)",
          "request": {
            "method": "POST",
            "header": [],
            "description": "قفل الشاشة ولوحة المفاتيح في الجهاز أثناء عمليات الصيانة وسحب البيانات.",
            "url": {
              "raw": "{{baseUrl}}/api/devices/{{deviceId}}/disable-device",
              "host": ["{{baseUrl}}"],
              "path": ["api", "devices", "{{deviceId}}", "disable-device"]
            }
          }
        },
        {
          "name": "2.12 Enable Device (إعادة تفعيل لوحة الجهاز)",
          "request": {
            "method": "POST",
            "header": [],
            "description": "إعادة إتاحة الجهاز للاستخدام وتسجيل بصمات الموظفين.",
            "url": {
              "raw": "{{baseUrl}}/api/devices/{{deviceId}}/enable-device",
              "host": ["{{baseUrl}}"],
              "path": ["api", "devices", "{{deviceId}}", "enable-device"]
            }
          }
        }
      ]
    },
    {
      "name": "3. الحضور والانصراف (Attendance Records)",
      "item": [
        {
          "name": "3.1 Get Attendance Records (استعلام الحضور مع فلاتر وتصفح كامل)",
          "request": {
            "method": "GET",
            "header": [],
            "description": "جلب سجلات الحضور والانصراف بقاعدة البيانات مع فلاتر متقدمة (deviceId, employeeId, deviceUserId, startDate, endDate, type) ونظام تصفح سريع (Pagination) لتجنب بطء استرجاع آلاف السجلات.",
            "url": {
              "raw": "{{baseUrl}}/api/attendance?deviceId=&employeeId=&deviceUserId=&startDate=&endDate=&type=&page=1&limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "attendance"],
              "query": [
                {
                  "key": "deviceId",
                  "value": "",
                  "description": "معرف الجهاز (اختياري)"
                },
                {
                  "key": "employeeId",
                  "value": "",
                  "description": "معرف الموظف الداخلي (اختياري)"
                },
                {
                  "key": "deviceUserId",
                  "value": "",
                  "description": "رقم البصمة الخاص بالموظف (اختياري)"
                },
                {
                  "key": "startDate",
                  "value": "",
                  "description": "تاريخ البداية (YYYY-MM-DD)"
                },
                {
                  "key": "endDate",
                  "value": "",
                  "description": "تاريخ النهاية (YYYY-MM-DD)"
                },
                {
                  "key": "type",
                  "value": "",
                  "description": "نوع الحركة: 0 = دخول (Check-in)، 1 = خروج (Check-out)، إلخ"
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "رقم الصفحة"
                },
                {
                  "key": "limit",
                  "value": "50",
                  "description": "عدد السجلات في كل صفحة (الحد الأقصى 1000)"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. الموظفون (Employees)",
      "item": [
        {
          "name": "4.1 Get Employees (جلب الموظفين مع الفلترة والبحث)",
          "request": {
            "method": "GET",
            "header": [],
            "description": "استعلام قائمة الموظفين مع فلترة الجهاز والبحث بالاسم أو رقم البصمة ودعم الـ Pagination.",
            "url": {
              "raw": "{{baseUrl}}/api/employees?deviceId=&search=&page=1&limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "employees"],
              "query": [
                {
                  "key": "deviceId",
                  "value": "",
                  "description": "معرف الجهاز لفلترة موظفي جهاز محدد (اختياري)"
                },
                {
                  "key": "search",
                  "value": "",
                  "description": "بحث بالاسم أو رقم البصمة (اختياري)"
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "رقم الصفحة"
                },
                {
                  "key": "limit",
                  "value": "50",
                  "description": "عدد الموظفين في الصفحة"
                }
              ]
            }
          }
        },
        {
          "name": "4.2 Create Employee (إضافة موظف جديد)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceUserId\": \"101\",\n  \"name\": \"أحمد محمد\",\n  \"deviceId\": \"{{deviceId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/employees",
              "host": ["{{baseUrl}}"],
              "path": ["api", "employees"]
            }
          }
        }
      ]
    },
    {
      "name": "5. لوحة التحكم والإحصائيات (Dashboard)",
      "item": [
        {
          "name": "5.1 Get Dashboard Stats (إحصائيات النظام العامة)",
          "request": {
            "method": "GET",
            "header": [],
            "description": "جلب إحصائيات سريعة للوحة التحكم: إجمالي الأجهزة، الأجهزة النشطة، عدد الموظفين، إجمالي الحركات، وحركات اليوم وآخر 7 أيام.",
            "url": {
              "raw": "{{baseUrl}}/api/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["api", "dashboard"]
            }
          }
        }
      ]
    }
  ]
}
