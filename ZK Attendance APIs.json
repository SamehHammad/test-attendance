{
  "info": {
    "name": "ZK Attendance APIs",
    "description": "Professional Postman collection for ZKTeco Attendance System APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "deviceId",
      "value": "ENTER_DEVICE_ID_HERE",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Get All Devices (جلب جميع الأجهزة)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/devices",
          "host": ["{{baseUrl}}"],
          "path": ["api", "devices"]
        }
      }
    },
    {
      "name": "2. Add New Device (إضافة جهاز جديد)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Main Door Device\",\n  \"ip\": \"192.168.1.201\",\n  \"port\": 4370,\n  \"location\": \"Main Entrance\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/devices",
          "host": ["{{baseUrl}}"],
          "path": ["api", "devices"]
        }
      }
    },
    {
      "name": "3. Test Connection (اختبار الاتصال)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/devices/{{deviceId}}/test-connection",
          "host": ["{{baseUrl}}"],
          "path": ["api", "devices", "{{deviceId}}", "test-connection"]
        }
      }
    },
    {
      "name": "4. Sync Data (مزامنة البيانات والحضور)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/devices/{{deviceId}}/sync",
          "host": ["{{baseUrl}}"],
          "path": ["api", "devices", "{{deviceId}}", "sync"]
        }
      }
    },
    {
      "name": "5. Sync Users (مزامنة الموظفين)",
      "request": {
        "method": "POST",
        "header": [],
