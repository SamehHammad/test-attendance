{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Trivvo Hr",
  "version": "1.0.0",
  "identifier": "com.hesabate.attendance",
  "build": {
    "frontendDist": "../splash",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Trivvo Hr",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../.next/standalone/": "standalone/",
      "../.env": ".env",
      "binaries/node-x86_64-pc-windows-msvc.exe": "binaries/node.exe"
    },
    "windows": {
      "nsis": {
        "languages": [
          "Arabic"
        ],
        "displayLanguageSelector": false,
        "installMode": "perMachine"
      }
    }
  }
}